# ==============================================================================
# myoneAI — Tamil JARVIS Configuration
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
JARVIS_NAME=JARVIS
DEFAULT_LANGUAGE=ta-IN

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# ------------------------------------------------------------------------------
# AI Provider (Cloud Inference - Zero heavy local LLMs)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=
AI_TIMEOUT=30.0
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_HISTORY_MESSAGES=12

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Settings (Tamil & Mixed Tamil-English)
# ------------------------------------------------------------------------------
STT_PROVIDER=google
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=ta-IN
STT_TIMEOUT=30.0

# Audio Capture & Voice Activity Detection (VAD)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_DURATION=15.0
VOICE_ACTIVITY_ENABLED=true
VAD_ENERGY_THRESHOLD=500.0
VAD_SILENCE_DURATION=1.5

# ------------------------------------------------------------------------------
# Voice Conversation Loop (Phase 5)
# ------------------------------------------------------------------------------
VOICE_LANGUAGE=ta-IN
VOICE_LISTEN_TIMEOUT=15.0
VOICE_INTERACTIVE_MODE=false

# ------------------------------------------------------------------------------
# Lightweight Wake Word Detection (Phase 6)
# ------------------------------------------------------------------------------
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis
WAKE_WORD_LANGUAGE=en-US
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_TIMEOUT=1.0
WAKE_WORD_COOLDOWN=1.5
WAKE_RESPONSE_ENABLED=true
WAKE_RESPONSE_TEXT=சொல்லுங்க.
WAKE_WORD_ON_BATTERY=true
WAKE_WORD_PROVIDER=local

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Settings (Natural Tamil Neural Voice)
# ------------------------------------------------------------------------------
TTS_PROVIDER=edge-tts
TTS_API_KEY=
TTS_MODEL=
TTS_LANGUAGE=ta-IN
TTS_VOICE=ta-IN-PallaviNeural
TTS_SPEED=1.0
TTS_VOLUME=1.0
TTS_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Security & Permissions Layer
# ------------------------------------------------------------------------------
REQUIRE_CONFIRMATION_FOR_SYSTEM_ACTIONS=true

# ------------------------------------------------------------------------------
# Secure PC Assistant Tools (Phase 8)
# ------------------------------------------------------------------------------
TOOLS_ENABLED=true
TOOL_DEFAULT_TIMEOUT=10.0
TOOL_CONFIRMATION_TIMEOUT=30.0
ALLOWED_DIRECTORIES=
ALLOWED_APPLICATIONS=
SCREENSHOT_DIRECTORY=data/screenshots
SCREENSHOT_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Controlled AI Memory System (Phase 7)
# ------------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_MAX_RESULTS=5
MEMORY_MAX_CONTEXT_CHARS=3000
MEMORY_REQUIRE_CONFIRMATION=true
MEMORY_DATABASE_PATH=data/memory.db

# ------------------------------------------------------------------------------
# Web Dashboard / Cloud API Integration
# ------------------------------------------------------------------------------
WEB_API_URL=http://localhost:8000
